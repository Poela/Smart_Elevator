# ============================================================
# Vorlage – kopiere diese Datei als ".env" und fülle die Werte aus.
# Die echte .env-Datei wird NICHT auf GitHub hochgeladen (.gitignore).
# ============================================================

# Datenbankverbindung
DB_HOST=localhost
DB_PORT=5432
DB_NAME=elevator_db
DB_USER=postgres
DB_PASSWORD=SICHERES_PASSWORT_HIER

# Elevision Public API
# JWT-Token aus dem Elevision-Portal kopieren (Settings → API-Keys)
ELEVISION_JWT_TOKEN=eyJ...DEIN_TOKEN_HIER
ELEVISION_API_BASE=https://api.elevision.de

# Optional: Logging & Monitoring
# LOG_LEVEL=INFO
# METRICS_PORT=8080
