        "rawSql": "SELECT TO_CHAR(gs, 'DD.MM (Dy)') AS \"Datum\", ROUND(la.avg_per_day::numeric, 1) AS \"Links L-Bau\", ROUND(re.avg_per_day::numeric, 1) AS \"Rechts L-Bau\", ROUND(ca.avg_per_day::numeric, 1) AS \"Campus HN\" FROM generate_series(NOW()::date, NOW()::date + INTERVAL '13 days', '1 day'::interval) gs LEFT JOIN (SELECT EXTRACT(DOW FROM time)::int AS dow, COUNT(*) * 1.0 / NULLIF(COUNT(DISTINCT date_trunc('day', time)), 0) AS avg_per_day FROM elevator_events ev JOIN elevators e ON e.id = ev.elevator_id WHERE e.name = 'Aufzug links L-Bau' GROUP BY EXTRACT(DOW FROM time)::int) la ON EXTRACT(DOW FROM gs)::int = la.dow LEFT JOIN (SELECT EXTRACT(DOW FROM time)::int AS dow, COUNT(*) * 1.0 / NULLIF(COUNT(DISTINCT date_trunc('day', time)), 0) AS avg_per_day FROM elevator_events ev JOIN elevators e ON e.id = ev.elevator_id WHERE e.name = 'Aufzug rechts L-Bau' GROUP BY EXTRACT(DOW FROM time)::int) re ON EXTRACT(DOW FROM gs)::int = re.dow LEFT JOIN (SELECT EXTRACT(DOW FROM time)::int AS dow, COUNT(*) * 1.0 / NULLIF(COUNT(DISTINCT date_trunc('day', time)), 0) AS avg_per_day FROM elevator_events ev JOIN elevators e ON e.id = ev.elevator_id WHERE e.name = 'Campus Brücken HN West' GROUP BY EXTRACT(DOW FROM time)::int) ca ON EXTRACT(DOW FROM gs)::int = ca.dow ORDER BY gs",
