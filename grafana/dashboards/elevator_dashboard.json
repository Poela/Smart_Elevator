      "title": "Fahrten pro $aggregation",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb-elevator"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('$aggregation', time) AS \"time\", COUNT(*) AS \"Aufzug links L-Bau\" FROM elevator_events ev JOIN elevators e ON e.id = ev.elevator_id WHERE e.name = 'Aufzug links L-Bau' AND $__timeFilter(ev.time) GROUP BY 1\nHAVING ('${filter_gaps}' = 'Aus' OR ($__timeTo()::timestamp - $__timeFrom()::timestamp) <= interval '30 days' OR COUNT(*) > 0)\nORDER BY 1",
          "refId": "A"
        },
