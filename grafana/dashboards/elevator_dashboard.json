          "rawSql": "SELECT time AS \"time\", floor AS \"Aufzug links\" FROM elevator_events ev JOIN elevators e ON e.id = ev.elevator_id WHERE e.name = 'Aufzug links L-Bau' AND $__timeFilter(ev.time) \nAND ('${filter_gaps}' = 'Aus' OR ($__timeTo()::timestamp - $__timeFrom()::timestamp) <= interval '30 days' OR floor IS NOT NULL)\nORDER BY time",
