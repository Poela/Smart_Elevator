          "rawQuery": true,
          "rawSql": "SELECT time AS \"time\", floor AS \"Aufzug links L-Bau\" FROM elevator_events ev JOIN elevators e ON e.id = ev.elevator_id WHERE e.name = 'Aufzug links L-Bau' AND $__timeFilter(ev.time) ORDER BY time",
