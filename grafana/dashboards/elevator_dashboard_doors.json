      "title": "Ø Reversierungen nach Temperaturbereich",
      "description": "Gruppiert nach Tagestemperatur – Zeigt ob Kälte oder Hitze mehr Türprobleme verursacht.",
      "type": "barchart",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb-elevator"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN w.temperature_avg < 0 THEN '< 0°C' WHEN w.temperature_avg < 10 THEN '0–10°C' WHEN w.temperature_avg < 20 THEN '10–20°C' WHEN w.temperature_avg < 30 THEN '20–30°C' ELSE '> 30°C' END AS \"Temperaturbereich\", ROUND(AVG(ds.reversing_count)::numeric, 2) AS \"Ø Reversierungen\", COUNT(*) AS \"Datenpunkte\" FROM elevator_door_stats ds JOIN elevators e ON e.id = ds.elevator_id JOIN weather_observations w ON date_trunc('day', ds.time AT TIME ZONE 'Europe/Berlin')::date = date_trunc('day', w.time AT TIME ZONE 'Europe/Berlin')::date WHERE e.name IN ($elevator) AND door IN ($door) GROUP BY 1 ORDER BY MIN(w.temperature_avg)",
          "refId": "A"
        }
      ]
