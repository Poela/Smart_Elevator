      "title": "Reversierungen nach Stockwerk",
      "description": "Welches Stockwerk hat die meisten Türprobleme?",
      "type": "barchart",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb-elevator"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(floor::text, '?') AS \"Stockwerk\", SUM(reversing_count) FILTER (WHERE e.name = 'Campus Brücken HN West') AS \"Campus HN West\", SUM(reversing_count) FILTER (WHERE e.name = 'Campus Brücken HN Ost') AS \"Campus HN Ost\", SUM(reversing_count) FILTER (WHERE e.name = 'Teststand lipah Aufzüge Heilbronn') AS \"Teststand lipah\" FROM elevator_door_stats ds JOIN elevators e ON e.id = ds.elevator_id WHERE e.name IN ($elevator) AND door IN ($door) AND $__timeFilter(ds.time) GROUP BY floor ORDER BY floor",
          "refId": "A"
        }
      ]
