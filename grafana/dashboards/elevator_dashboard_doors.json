      "title": "Öffnungs- und Schließzeit im Verlauf",
      "description": "Langsam werdende Türen = Verschleißsignal.",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb-elevator"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ds.time AS \"time\", AVG(avg_opening_ms) AS \"Ø Öffnungszeit\", CASE WHEN e.name LIKE '%HN Ost%' THEN 'HN Ost' WHEN e.name LIKE '%HN West%' THEN 'HN West' WHEN e.name LIKE '%Teststand%' THEN 'Teststand' WHEN e.name LIKE '%links L-Bau%' THEN 'L-Bau Li.' WHEN e.name LIKE '%rechts L-Bau%' THEN 'L-Bau Re.' ELSE e.name END AS name FROM elevator_door_stats ds JOIN elevators e ON e.id = ds.elevator_id WHERE e.name IN ($elevator) AND door IN ($door) AND $__timeFilter(ds.time) GROUP BY ds.time, e.name ORDER BY ds.time",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb-elevator"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ds.time AS \"time\", AVG(avg_closing_ms) AS \"Ø Schließzeit\", CASE WHEN e.name LIKE '%HN Ost%' THEN 'HN Ost' WHEN e.name LIKE '%HN West%' THEN 'HN West' WHEN e.name LIKE '%Teststand%' THEN 'Teststand' WHEN e.name LIKE '%links L-Bau%' THEN 'L-Bau Li.' WHEN e.name LIKE '%rechts L-Bau%' THEN 'L-Bau Re.' ELSE e.name END AS name FROM elevator_door_stats ds JOIN elevators e ON e.id = ds.elevator_id WHERE e.name IN ($elevator) AND door IN ($door) AND $__timeFilter(ds.time) GROUP BY ds.time, e.name ORDER BY ds.time",
          "refId": "B"
        }
      ]
    },
