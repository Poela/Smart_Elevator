          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.name AS \"Aufzug\", ROUND(AVG(availability_pct)::numeric, 1) AS \"Verfügbarkeit %\" FROM elevator_availability ea JOIN elevators e ON e.id = ea.elevator_id WHERE e.name IN ($elevator) AND $__timeFilter(ea.time) GROUP BY e.name ORDER BY e.name",
