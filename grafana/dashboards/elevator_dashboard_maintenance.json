      "title": "Aktueller Status pro Aufzug",
      "type": "table",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb-elevator"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (e.name) e.name AS \"Aufzug\", ROUND(availability_pct::numeric, 1) AS \"Verfügbarkeit %\", operating_category AS \"Status\", CASE WHEN online THEN '🟢 Online' ELSE '🔴 Offline' END AS \"Verbindung\", to_char(ea.time AT TIME ZONE 'Europe/Berlin', 'DD.MM. HH24:MI') AS \"Letzter Check\" FROM elevator_availability ea JOIN elevators e ON e.id = ea.elevator_id WHERE e.name IN ($elevator) ORDER BY e.name, ea.time DESC",
          "refId": "A"
        }
      ]
