          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', cs.time) AS \"time\", SUM(motor_start_up + motor_start_down) AS \"Motorstarts/Tag\" FROM elevator_count_stats cs JOIN elevators e ON e.id = cs.elevator_id WHERE e.name IN ($elevator) AND $__timeFilter(cs.time) GROUP BY 1 ORDER BY 1",
