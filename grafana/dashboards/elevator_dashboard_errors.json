          "rawSql": "SELECT LPAD(EXTRACT(HOUR FROM ee.time AT TIME ZONE 'Europe/Berlin')::text, 2,'0') || ':00' AS \"Tageszeit\", COUNT(*) FILTER (WHERE category = 'DOOR')          AS \"DOOR\", COUNT(*) FILTER (WHERE category = 'DRIVE')         AS \"DRIVE\", COUNT(*) FILTER (WHERE category = 'SAFETY_CIRCUIT') AS \"SAFETY_CIRCUIT\", COUNT(*) FILTER (WHERE category NOT IN ('DOOR','DRIVE','SAFETY_CIRCUIT')) AS \"SONSTIGE\" FROM elevator_errors ee JOIN elevators e ON e.id = ee.elevator_id WHERE e.name IN ($elevator) AND $__timeFilter(ee.time) GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ]
    },
