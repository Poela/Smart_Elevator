          "rawSql": "SELECT COALESCE(floor::text, '?') AS \"Stockwerk\", COUNT(*) FILTER (WHERE category = 'DOOR')  AS \"DOOR\", COUNT(*) FILTER (WHERE category = 'DRIVE') AS \"DRIVE\", COUNT(*) FILTER (WHERE category NOT IN ('DOOR','DRIVE')) AS \"SONSTIGE\" FROM elevator_errors ee JOIN elevators e ON e.id = ee.elevator_id WHERE e.name IN ($elevator) AND $__timeFilter(ee.time) GROUP BY floor ORDER BY floor",
