      "title": "Ø Fahrten pro Wochentag",
      "description": "Montag–Freitag erwartet höhere Nutzung als Wochenende.",
      "type": "barchart",
      "targets": [{
        "datasource": { "type": "postgres", "uid": "timescaledb-elevator" },
        "format": "table", "rawQuery": true,
        "rawSql": "SELECT CASE day_of_week WHEN 0 THEN 'So' WHEN 1 THEN 'Mo' WHEN 2 THEN 'Di' WHEN 3 THEN 'Mi' WHEN 4 THEN 'Do' WHEN 5 THEN 'Fr' WHEN 6 THEN 'Sa' END AS \"Wochentag\", ROUND(SUM(CASE WHEN elevator_name = 'Aufzug links L-Bau'     THEN avg_trips_per_day ELSE 0 END)::numeric, 1) AS \"Links L-Bau\", ROUND(SUM(CASE WHEN elevator_name = 'Aufzug rechts L-Bau'    THEN avg_trips_per_day ELSE 0 END)::numeric, 1) AS \"Rechts L-Bau\", ROUND(SUM(CASE WHEN elevator_name = 'Campus Brücken HN West' THEN avg_trips_per_day ELSE 0 END)::numeric, 1) AS \"Campus HN\", ROUND(SUM(CASE WHEN elevator_name = 'Feuerwehraufzug L-Bau'  THEN avg_trips_per_day ELSE 0 END)::numeric, 1) AS \"Feuerwehr\" FROM v_weekday_pattern WHERE elevator_name IN ($elevator) GROUP BY day_of_week ORDER BY day_of_week",
        "refId": "A"
      }]
    },

