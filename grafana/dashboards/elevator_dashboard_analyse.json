          "rawSql": "SELECT day AS \"time\", ROUND(AVG(cnt) OVER (ORDER BY day ROWS BETWEEN 6 PRECEDING AND CURRENT ROW)::numeric, 1) AS \"7-Tage-Trend (Links)\" FROM (SELECT date_trunc('day', time) AS day, COUNT(*) AS cnt FROM elevator_events ev JOIN elevators e ON e.id = ev.elevator_id WHERE e.name = 'Aufzug links L-Bau' AND $__timeFilter(ev.time) GROUP BY 1) t ORDER BY day",
          "refId": "B"
        },
