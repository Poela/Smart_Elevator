      "title": "Fahrtenverlauf & 7-Tage-Gleitender Durchschnitt",
      "description": "Tatsächliche Tagesfahrten kombiniert mit dem 7-Tage-Trend als gestrichelte Linie.",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "timescaledb-elevator" },
          "format": "time_series", "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', time) AS \"time\", COUNT(*) AS \"Links L-Bau\" FROM elevator_events ev JOIN elevators e ON e.id = ev.elevator_id WHERE e.name = 'Aufzug links L-Bau' AND $__timeFilter(ev.time) GROUP BY 1 ORDER BY 1",
          "refId": "A"
