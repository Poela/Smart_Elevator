        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "orientation": "auto", "showValue": "never", "stacking": "none",
        "tooltip": { "mode": "multi", "sort": "desc" },
        "xTickLabelRotation": 0, "xTickLabelSpacing": 100, "xField": "Uhrzeit"
      },
      "title": "Ø Fahrten pro Tagesstunde – Betätigungsmuster",
      "description": "Erkennbare Peaks: Arbeitsbeginn (~7–9 Uhr), Mittagspause (~11:30–13 Uhr), Feierabend (~16–18 Uhr).",
      "type": "barchart",
      "targets": [{
        "datasource": { "type": "postgres", "uid": "timescaledb-elevator" },
        "format": "table", "rawQuery": true,
        "rawSql": "SELECT LPAD(hour_of_day::text, 2, '0') || ':00' AS \"Uhrzeit\", ROUND(SUM(CASE WHEN elevator_name = 'Aufzug links L-Bau'     THEN avg_trips_per_hour ELSE 0 END)::numeric, 2) AS \"Links L-Bau\", ROUND(SUM(CASE WHEN elevator_name = 'Aufzug rechts L-Bau'    THEN avg_trips_per_hour ELSE 0 END)::numeric, 2) AS \"Rechts L-Bau\", ROUND(SUM(CASE WHEN elevator_name = 'Campus Brücken HN West' THEN avg_trips_per_hour ELSE 0 END)::numeric, 2) AS \"Campus HN\", ROUND(SUM(CASE WHEN elevator_name = 'Feuerwehraufzug L-Bau'  THEN avg_trips_per_hour ELSE 0 END)::numeric, 2) AS \"Feuerwehr\" FROM v_hourly_pattern WHERE elevator_name IN ($elevator) GROUP BY hour_of_day ORDER BY hour_of_day",
        "refId": "A"
      }]
    },

