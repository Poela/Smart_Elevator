      "title": "Top-Stunden nach Auslastung",
      "description": "Die 10 betrieblichsten Stunden gemittelt über alle gewählten Aufzüge.",
      "type": "table",
      "targets": [{
        "datasource": { "type": "postgres", "uid": "timescaledb-elevator" },
        "format": "table", "rawQuery": true,
        "rawSql": "SELECT LPAD(hour_of_day::text, 2, '0') || ':00 Uhr' AS \"Tageszeit\", ROUND(AVG(avg_trips_per_hour)::numeric, 2) AS \"Ø Fahrten\", CASE WHEN hour_of_day BETWEEN 7 AND 9 THEN '☀️ Arbeitsbeginn' WHEN hour_of_day BETWEEN 11 AND 13 THEN '🍽️ Mittagspause' WHEN hour_of_day BETWEEN 16 AND 18 THEN '🏠 Feierabend' ELSE '' END AS \"Zeitfenster\" FROM v_hourly_pattern WHERE elevator_name IN ($elevator) GROUP BY hour_of_day ORDER BY \"Ø Fahrten\" DESC LIMIT 10",
        "refId": "A"
      }]
    },

