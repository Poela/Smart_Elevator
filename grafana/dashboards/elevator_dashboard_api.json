          "rawSql": "SELECT e.name AS \"Controller\", CASE WHEN ea.online THEN 'true' ELSE 'false' END AS \"Online\", ROUND(ea.availability_pct::numeric, 1) AS \"Verfuegbarkeit %\", ea.operating_category AS \"Betriebsart\", to_char(ea.time AT TIME ZONE 'Europe/Berlin', 'DD.MM HH24:MI') AS \"Zuletzt gesehen\" FROM (SELECT DISTINCT ON (elevator_id) * FROM elevator_availability ORDER BY elevator_id, time DESC) ea JOIN elevators e ON e.id = ea.elevator_id ORDER BY e.name",
