          "rawSql": "SELECT LPAD(hour_of_day::text, 2, '0') || 'h' AS \"Stunde\", COALESCE(MAX(CASE WHEN floor = 0  THEN occurrences END), 0) AS \"EG\", COALESCE(MAX(CASE WHEN floor = 1  THEN occurrences END), 0) AS \"1.OG\", COALESCE(MAX(CASE WHEN floor = 2  THEN occurrences END), 0) AS \"2.OG\", COALESCE(MAX(CASE WHEN floor = 3  THEN occurrences END), 0) AS \"3.OG\", COALESCE(MAX(CASE WHEN floor = 4  THEN occurrences END), 0) AS \"4.OG\", COALESCE(MAX(CASE WHEN floor = 5  THEN occurrences END), 0) AS \"5.OG\", COALESCE(MAX(CASE WHEN floor >= 6 THEN occurrences END), 0) AS \"6.OG+\" FROM v_floor_by_hour WHERE elevator_name = 'Aufzug rechts L-Bau' GROUP BY hour_of_day ORDER BY hour_of_day",
          "refId": "A"
        }
