      "title": "Empfohlene Stockwerk-Positionen je Stunde (0–23 Uhr)",
      "description": "Statistisch optimale Vorpositionierung. Konfidenz = Anteil dieser Stockwerk-Ereignisse an der Gesamtstunde.",
      "type": "table",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb-elevator"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT LPAD(hour_of_day::text, 2, '0') || ':00 Uhr' AS \"Uhrzeit\", MAX(CASE WHEN elevator_name = 'Aufzug links L-Bau'     THEN 'OG ' || recommended_floor END) AS \"Links L-Bau\", MAX(CASE WHEN elevator_name = 'Aufzug links L-Bau'     THEN confidence_pct END)::numeric AS \"Links %\", MAX(CASE WHEN elevator_name = 'Aufzug rechts L-Bau'    THEN 'OG ' || recommended_floor END) AS \"Rechts L-Bau\", MAX(CASE WHEN elevator_name = 'Aufzug rechts L-Bau'    THEN confidence_pct END)::numeric AS \"Rechts %\", MAX(CASE WHEN elevator_name = 'Campus Brücken HN West' THEN 'OG ' || recommended_floor END) AS \"Campus HN\", MAX(CASE WHEN elevator_name = 'Campus Brücken HN West' THEN confidence_pct END)::numeric AS \"Campus %\", MAX(CASE WHEN elevator_name = 'Feuerwehraufzug L-Bau'  THEN 'OG ' || recommended_floor END) AS \"Feuerwehr\", MAX(CASE WHEN elevator_name = 'Feuerwehraufzug L-Bau'  THEN confidence_pct END)::numeric AS \"FW %\" FROM v_predicted_floor GROUP BY hour_of_day ORDER BY hour_of_day",
          "refId": "A"
        }
      ]
    },
